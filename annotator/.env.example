# Copy to .env and fill in EVERY value. Never commit .env.
# Generate secrets with:  openssl rand -base64 32   (or: python -c "import secrets;print(secrets.token_urlsafe(48))")

# --- Network ---
# Hostname or LAN IP that browsers use to reach this machine. Must match the TLS cert (scripts/gen-certs.sh).
APP_HOST=annotator.lan
HTTP_PORT=80
HTTPS_PORT=443
MINIO_PUBLIC_PORT=9443

# --- Image tags (defaults are the images already present locally) ---
POSTGRES_TAG=16
NGINX_TAG=1.27-alpine
NODE_TAG=20-alpine

# --- Postgres ---
POSTGRES_USER=annotator
POSTGRES_PASSWORD=
POSTGRES_DB=annotator

# --- MinIO ---
# Root credentials: used only by minio-init, never by the app.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# App-scoped credentials (created by minio-init; access limited to the 3 buckets).
# S3_APP_ACCESS_KEY MUST differ from MINIO_ROOT_USER (>= 3 chars; secret >= 8 chars).
S3_APP_ACCESS_KEY=
S3_APP_SECRET_KEY=
# The MinIO admin console is never published; keep it off
MINIO_BROWSER=off
# Pinned images; bump deliberately after checking release notes/licence
MINIO_TAG=RELEASE.2024-08-29T01-40-52Z
MC_TAG=RELEASE.2024-08-17T11-33-50Z

# --- Backend ---
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_UPLOAD_MB=100
API_WORKERS=2
WORKER_CONCURRENCY=2
LOG_LEVEL=info
APP_VERSION=local

