# Rendered by the nginx image's envsubst step (only APP_*/HTTPS_*/MINIO_*/MAX_* variables are substituted;
# see NGINX_ENVSUBST_FILTER in docker-compose.yml). Output replaces /etc/nginx/conf.d/default.conf.
#
# One nginx serves three things:
#   :80    redirect to HTTPS (+ /healthz-proxy for the container healthcheck)
#   :443   React app (static files) and /api -> FastAPI
#   :9443  MinIO S3 API for the browser's presigned PUT/GET (Host header must pass through unchanged)

resolver 127.0.0.11 valid=10s ipv6=off;   # Docker DNS: containers may restart with new IPs

# ---- http-level: security headers (inherited by every location that sets no add_header of its own).
# No HSTS on purpose: with a self-signed certificate it would make the browser warning impossible to bypass.
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "same-origin" always;
add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data: https://${APP_HOST}:${MINIO_PUBLIC_PORT}; connect-src 'self' https://${APP_HOST}:${MINIO_PUBLIC_PORT}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
server_tokens off;

limit_req_zone $binary_remote_addr zone=login:10m rate=30r/m;

# Reflect the browser's Origin for the S3 port only when it is this app (any port).
map $http_origin $cors_origin {
    default "";
    "~*^https://${APP_HOST}(:[0-9]+)?$" $http_origin;
}

server {
    listen 80 default_server;
    server_name _;

    location = /healthz-proxy {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
    location / {
        return 301 https://${APP_HOST}:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    client_max_body_size 2m;   # /api bodies are JSON; image bytes go straight to MinIO

    # API -> FastAPI. Variable in proxy_pass = resolve at request time and pass the URI through untouched.
    location /api/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;      # overwrite, never append: the client must not spoof its IP
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;                            # /images/{id}/complete hashes + decodes the upload
    }
    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /healthz {
        access_log off;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
    }

    # Vite output is content-hashed: cache forever. index.html must always be revalidated.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}

# MinIO S3 API for presigned URLs. The signature covers the Host header, so it is forwarded exactly as sent.
server {
    listen 9443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 0;
    ignore_invalid_headers off;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_origin always;
            add_header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Vary Origin always;
            return 204;
        }
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_hide_header Access-Control-Allow-Origin;      # MinIO's own "*" would duplicate ours
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Expose-Headers "ETag" always;
        add_header Vary Origin always;
    }
}
